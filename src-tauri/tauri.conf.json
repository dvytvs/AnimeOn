{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnimeOn",
  "version": "1.0.0",
  "identifier": "com.animeon.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "default",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "opener:default",
            {
              "identifier": "opener:allow-open-url",
              "allow": [
                "https://animeon.cc/*",
                "https://v2.animeon.co/*",
                "https://accounts.google.com/*"
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
